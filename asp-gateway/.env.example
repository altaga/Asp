# Asp Gateway — Monad
# The gateway only receives USDC, so it needs an address, never a private key.
GATEWAY_ADDRESS=0x0000000000000000000000000000000000000000
# 143 = Monad mainnet, 10143 = Monad testnet
MONAD_CHAIN_ID=143
# Optional: preferred RPC (public Monad RPCs are used as fallback)
MONAD_RPC_URL=
# eth_getLogs range per call (100 public Monad RPC, 10 on Alchemy free tier)
MONAD_LOGS_SPAN=
# Optional: override the Circle USDC address for the chain above
USDC_ADDRESS=

MQTT_BROKER_URL=wss://mqtt.example.com:443
MQTT_BROKER_JWT=REPLACE_WITH_GATEWAY_BROKER_JWT
ASP_GW_HOST=0.0.0.0
ASP_GW_HTTP_PORT=8086
# Monad x402 facilitator (see x402-examples/Facilitator)
FACILITATOR_URL=http://127.0.0.1:8095

# Where claims, tickets and spent tx hashes are kept across restarts (default ./data)
ASP_DATA_DIR=
# Operator token for /asp/demo/reset-claims and /asp/kiosk/reset (header x-asp-admin). Empty = resets disabled.
ASP_ADMIN_TOKEN=

# World ID (Proof of Human) — server verify fail-closed
WORLD_APP_ID=app_REPLACE_ME
WORLD_RP_ID=rp_REPLACE_ME
WORLD_ENVIRONMENT=sandbox
# Issued once by Portal staging window (24h). Required for staging/sandbox proofs.
WORLD_STAGING_VERIFICATION_TOKEN=REPLACE_ME

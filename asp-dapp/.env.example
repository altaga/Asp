# Bedrock agent for /chat (server-side only — never commit real tokens)
AMAZON_BEDROCK_BEARER_TOKEN=your_aws_bedrock_bearer_token_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0

# Asp gateway (public hire + petition + agent-guide)
EXPO_PUBLIC_GATEWAY_URL=https://gateway.example.com

# World ID / IDKit (Selfie Check) — client needs EXPO_PUBLIC_* mirrors
EXPO_PUBLIC_WORLD_APP_ID=app_REPLACE_ME
EXPO_PUBLIC_WORLD_RP_ID=rp_REPLACE_ME
EXPO_PUBLIC_WORLD_ENVIRONMENT=staging
WORLD_APP_ID=app_REPLACE_ME
WORLD_RP_ID=rp_REPLACE_ME
WORLD_RP_SIGNING_KEY=REPLACE_WITH_PORTAL_SIGNING_KEY_HEX
# Staging/sandbox proofs only — issued by the Portal, expires in 24h
WORLD_STAGING_VERIFICATION_TOKEN=REPLACE_ME

# WalletConnect (Reown Cloud project id) + Monad chain (143 mainnet, 10143 testnet)
EXPO_PUBLIC_REOWN_PROJECT_ID=REPLACE_WITH_REOWN_PROJECT_ID
EXPO_PUBLIC_MONAD_CHAIN_ID=143
MONAD_RPC_URL=

# /test NFT drop — AspDrop contract (asp-nft) and its owner key, server-only
EXPO_PUBLIC_ASP_DROP_ADDRESS=0x942c1a378b961fb7a95b83ecaf55fecee42c6187
NFT_MINTER_PRIVATE_KEY=REPLACE_WITH_GENERATED_KEY
